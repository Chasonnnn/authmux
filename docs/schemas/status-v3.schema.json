{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chasonnnn/authmux/blob/main/docs/schemas/status-v3.schema.json",
  "title": "authmux status schema version 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "context", "observations"],
  "properties": {
    "schema_version": { "const": 3 },
    "command": { "const": "status" },
    "context": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "credential_plane",
        "profile",
        "expected_identity",
        "observed_identity",
        "identity_match",
        "expected_source_identity",
        "observed_source_identity",
        "source_identity_match",
        "expected_project",
        "observed_project",
        "project_match",
        "session_usability",
        "reason",
        "reauthentication_need",
        "evidence_level",
        "provider_contacted",
        "transport_reuse",
        "observed_at_unix"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "credential_plane": {
          "type": ["string", "null"],
          "enum": ["gcloud_cli", "adc", null]
        },
        "profile": { "type": "string", "minLength": 1 },
        "expected_identity": { "type": "string", "minLength": 1 },
        "observed_identity": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "identity_match": {
          "enum": ["match", "mismatch", "unverified"]
        },
        "expected_source_identity": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "observed_source_identity": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_identity_match": {
          "type": ["string", "null"],
          "enum": ["match", "mismatch", "unverified", null]
        },
        "expected_project": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "observed_project": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "project_match": {
          "type": ["string", "null"],
          "enum": ["match", "mismatch", "unverified", null]
        },
        "session_usability": {
          "enum": ["usable", "unusable", "indeterminate"]
        },
        "reason": {
          "enum": [
            "none",
            "expired",
            "missing",
            "unreachable",
            "provider_error",
            "insufficient_evidence"
          ]
        },
        "reauthentication_need": {
          "enum": ["required", "not_required", "unknown", "not_applicable"]
        },
        "evidence_level": {
          "enum": [
            "local_metadata",
            "provider_validation",
            "connectivity_only"
          ]
        },
        "provider_contacted": { "type": "boolean" },
        "transport_reuse": {
          "type": ["string", "null"],
          "enum": ["active", "inactive", "unknown", null]
        },
        "observed_at_unix": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
