{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chasonnnn/authmux/blob/main/docs/schemas/doctor-v1.schema.json",
  "title": "authmux doctor schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "context",
    "result",
    "provider_contacted",
    "checks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "doctor" },
    "context": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "warning", "fail"] },
    "provider_contacted": { "const": false },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["pass", "warning", "fail"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
